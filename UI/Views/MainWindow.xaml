<Window x:Class="CatalogEntitlementManager.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:CatalogEntitlementManager.UI.ViewModels"
        xmlns:views="clr-namespace:CatalogEntitlementManager.UI.Views"
        mc:Ignorable="d"
        Title="Game Catalog"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#F8FAFC"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0.85,1">
            <GradientStop Color="#AFF3F7FF" Offset="0" />
            <GradientStop Color="#28D8E5FF" Offset="0.52" />
            <GradientStop Color="#85DCE9FF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassPanel" StartPoint="0,0" EndPoint="0.84,1">
            <GradientStop Color="#6F25343D" Offset="0" />
            <GradientStop Color="#8A111721" Offset="0.48" />
            <GradientStop Color="#75202A36" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassCard" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#32EAF6FF" Offset="0" />
            <GradientStop Color="#48101925" Offset="0.55" />
            <GradientStop Color="#70202835" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassAction" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#62F0F5FF" Offset="0" />
            <GradientStop Color="#32C1D7F1" Offset="0.52" />
            <GradientStop Color="#476A91B7" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="GlassInput" Color="#60101822" />
        <SolidColorBrush x:Key="GlassScrim" Color="#49080B12" />
        <SolidColorBrush x:Key="DesktopGlassTint" Color="#48101B29" />
        <DrawingBrush x:Key="CoverMask" Stretch="Fill">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="Black" Geometry="M 0,133 L 0,14 Q 0,0 14,0 L 273,0 Q 287,0 287,14 L 287,133 Z" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#34B5D6FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource GlassAction}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="21"
                                BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="Shine" Background="#50FFFFFF" CornerRadius="18" Opacity="0" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="Motion" />
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.14" /></Storyboard></BeginStoryboard></MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" /></Storyboard></BeginStoryboard></MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#52718DAA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#87637C99" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#E5F4FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"><Setter Property="Tag" Value="Motion" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#28BAC8DB" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="secBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="secBorder" Property="Background" Value="#80698DBC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="secBorder" Property="Background" Value="#A17193B9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="secBorder" Property="BorderBrush" Value="#D7EEFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="secBorder" Property="Opacity" Value="0.50" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogCardStyle" TargetType="Border">
            <Setter Property="Width" Value="287" />
            <Setter Property="Margin" Value="0,0,12,14" />
            <Setter Property="Background" Value="{DynamicResource GlassCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="23" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

    </Window.Resources>

    <Border x:Name="WindowSurface" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="9"
            Background="{DynamicResource DesktopGlassTint}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Frameless Title Bar -->
            <Border Grid.Row="0"
                    Background="#26212933"
                    BorderBrush="#29AAC8EA"
                    BorderThickness="0,0,0,1">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Branding -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Game Catalog"
                                   FontWeight="Bold"
                                   FontSize="12.5"
                                   Foreground="#F1F5F9"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Window Controls -->
                    <Button Grid.Column="2" Click="OpenProfile_OnClick" ToolTip="Local profile"
                            AutomationProperties.Name="Open local profile" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="Transparent" BorderThickness="0" Padding="2" Margin="0,0,10,0">
                        <Grid Width="32" Height="32">
                            <Ellipse Fill="{DynamicResource GlassPanel}" Stroke="{DynamicResource GlassEdge}"/>
                            <TextBlock x:Name="PlayerInitial" Text="○" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse><Ellipse.Fill><ImageBrush x:Name="PlayerAvatar" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                        </Grid>
                    </Button>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_OnClick" ToolTip="Minimize">
                            <TextBlock Text="—" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeRestoreButton_OnClick" ToolTip="Maximize / Restore">
                            <TextBlock Text="☐" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="CloseButton_OnClick" ToolTip="Close">
                            <TextBlock Text="✕" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <DockPanel Grid.Row="1" Margin="20,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Click="OpenLibrary_OnClick" Content="Library" Margin="12,0,0,0"/>
                <ComboBox DockPanel.Dock="Right" Width="120" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" AutomationProperties.Name="Theme"/>
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="10,6" Margin="0,0,12,0" ToolTip="Search by title, genre or AppID" AutomationProperties.Name="Search games"/>
            </DockPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="{DynamicResource CatalogVeil}" Padding="20">
                <ItemsControl ItemsSource="{Binding FilteredTitles}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource CatalogCardStyle}" Padding="10"><StackPanel>
                            <Image Source="{Binding ArtworkUri}" Height="124" Stretch="UniformToFill"/>
                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Margin="2,8" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Genre}" Foreground="#BDCDD9" Margin="2,0,0,10"/>
                            <Button HorizontalAlignment="Left" Content="View on Steam" Style="{StaticResource SecondaryButtonStyle}" Click="OpenStore"/>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>

