<Window x:Class="CatalogEntitlementManager.UI.Views.LocalLibraryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Library" Width="760" Height="600" MinWidth="510" MinHeight="420" WindowStartupLocation="CenterOwner"
 Style="{x:Null}" AllowsTransparency="False" Background="#172331" Foreground="#F1F6FF" FontFamily="Segoe UI" Loaded="Window_Loaded">
 <Border Background="{DynamicResource GlassPanel}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" Padding="20">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource GlassCard}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" DockPanel.Dock="Left" Margin="0,0,12,0">
    <Grid><TextBlock x:Name="Initial" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
     <Ellipse><Ellipse.Fill><ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse></Grid>
   </Border>
   <TextBlock x:Name="PlayerHeading" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
  </DockPanel>
  <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
   <TabItem Header="Library">
    <Grid Margin="2,14,2,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12">
      <Button Content="Add game" Style="{DynamicResource SecondaryButtonStyle}" DockPanel.Dock="Right" Click="Add_Click" Margin="8,0,0,0" Padding="12,5"/>
      <ComboBox x:Name="Picker" DisplayMemberPath="Title" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Title" AutomationProperties.Name="Choose a catalog game"/>
     </DockPanel>
     <ListBox Grid.Row="1" x:Name="Games" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <Border Background="{DynamicResource GlassCard}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="14" Padding="8" Margin="0,0,5,9">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="144"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Height="75" CornerRadius="8" Background="{DynamicResource GlassInput}">
         <Grid>
          <TextBlock Text="{Binding Title}" Foreground="#B2C6D3" Margin="7" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Border CornerRadius="8"><Border.Background><ImageBrush ImageSource="{Binding ArtworkUri}" Stretch="UniformToFill"/></Border.Background></Border>
         </Grid>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,8,0"><TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="#F1F6FF" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Foreground="#BDCDD9" FontSize="12" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
         <Button Content="{Binding Action}" Style="{DynamicResource SecondaryButtonStyle}" Click="Open_Click" Padding="10,5"/>
         <Button Content="Remove" Click="Remove_Click" ToolTip="Remove from this list" FontSize="11" Foreground="#BDCDD9" Background="Transparent" BorderThickness="0" Padding="6,3"/>
        </StackPanel>
       </Grid>
       </Border>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </TabItem>
   <TabItem x:Name="ProfileTab" Header="Profile">
    <StackPanel Margin="4,18">
     <TextBlock Text="Profile name" Margin="0,0,0,6"/><TextBox x:Name="ProfileName" MaxLength="48" AutomationProperties.Name="Profile name"/>
     <WrapPanel Margin="0,14,0,12"><Button Content="Choose photo" Click="Photo_Click" Margin="0,0,8,0"/><Button Content="Remove photo" Click="ClearPhoto_Click"/></WrapPanel>
     <TextBlock Text="Saved on this device." Foreground="#B2C6D3" Margin="0,0,0,14"/>
     <Button Content="Save profile" Click="SaveProfile_Click" HorizontalAlignment="Left"/>
    </StackPanel>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" x:Name="Feedback" TextWrapping="Wrap" Foreground="#C7DBE6" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
 </Border>
</Window>

